# Core Files
/config.php
/index_custom.php
/index_customSidebar.php

# Uploads Folder
uploads/*
!uploads/.htaccess

# Themes Folder
themes/*
!themes/Default
!themes/Legacy
!themes/2021

# Test generated temporary files
tests/_logs/*
tests/_dump/*
tests/_support/_generated/*
tests/_output
.phpunit.result.cache

# Template Cache
/resources/templates/cache/*

# Misc System Temp Files
Thumb.db
.DS_Store
*~
nbproject/

# Vendor Libraries
/vendor

# Var Folder
var/*
!var/.htaccess

# Ignore node_modules folder
node_modules

.phpactor.json

# Docker environment — never commit real credentials
.env

# Test fixture carrying real person records, including passwordStrong /
# passwordStrongSalt hashes. It is a copy of live school data, so it must stay
# out of the repository; regenerate your own fixture locally if a test needs it.
/tests/_data/dump.sql

# Backups taken during the chat -> Messenger merge. These contain production
# schema and permission rows, and the permission one is the only record of what
# the grants looked like before the merge.
/backups/

# Config backups carry the live database password in clear text. config.php
# itself is ignored above; its backups have to be named too, or a stray
# config.php.bak-<date> is one `git add .` away from being public.
/config.php.bak*
/config.php.old*
/config-*.php

# Build artifacts and full-tree snapshots. These are release assets, not source:
# the zips are copies of this repository and the APKs are compiled from the
# Flutter client. Three of them are over 200 MB, which GitHub rejects outright,
# and none of it belongs in version control.
/tawasul_os.zip
/tawasul-school-os.zip
/app-debug.apk
/app-release.apk
*.apk
